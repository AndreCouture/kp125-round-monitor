"""Refuse commits that would leak credentials. Enabled with: git config core.hooksPath .githooks

Blocks a commit when the staged changes contain:
  1. any file named secrets.h (only secrets.example.h belongs in git);
  2. a value from the local, git-ignored secrets.h files (Wi-Fi SSID/password, TP-Link account);
  3. a WIFI_PASS / KASA_USER / KASA_PASS definition that isn't one of the example placeholders.
Matches are reported by key and file only; the secret itself is never printed.
"""
import re
import subprocess
import sys
from pathlib import Path

KEYS = ("WIFI_SSID", "WIFI_PASS", "KASA_USER", "KASA_PASS")
PLACEHOLDERS = {"your-ssid", "your-password", "you@example.com", "your-kasa-password", ""}
DEFINE = re.compile(r'#define\s+(WIFI_PASS|KASA_USER|KASA_PASS)\s+"([^"]*)"')


def git(*args: str) -> str:
    return subprocess.run(["git", *args], capture_output=True, text=True, check=True).stdout


def main() -> int:
    root = Path(git("rev-parse", "--show-toplevel").strip())
    problems = []

    staged = [p for p in git("diff", "--cached", "--name-only", "--diff-filter=ACMR").splitlines() if p]
    for p in staged:
        if Path(p).name == "secrets.h":
            problems.append(f"{p}: secrets.h must never be committed (it is git-ignored for a reason)")

    # Real values from the local secrets.h files
    secrets = {}
    for f in root.rglob("secrets.h"):
        text = f.read_text(errors="ignore")
        for k in KEYS:
            m = re.search(r"#define\s+" + k + r'\s+"([^"]*)"', text)
            if m and m.group(1) not in PLACEHOLDERS and len(m.group(1)) >= 4:
                secrets[m.group(1)] = k

    current = None
    for line in git("diff", "--cached", "-U0", "--no-color").splitlines():
        if line.startswith("+++ "):
            current = line[6:] if line.startswith("+++ b/") else line[4:]
            continue
        if not line.startswith("+") or line.startswith("+++"):
            continue
        added = line[1:]
        for value, key in secrets.items():
            if value in added:
                problems.append(f"{current}: contains the real {key} from your secrets.h")
        m = DEFINE.search(added)
        if m and m.group(2) not in PLACEHOLDERS:
            problems.append(f"{current}: defines {m.group(1)} with a non-placeholder value")

    if problems:
        print("pre-commit: refusing to commit possible secrets:", file=sys.stderr)
        for p in sorted(set(problems)):
            print("  - " + p, file=sys.stderr)
        print("Unstage them (git restore --staged <file>) or replace the values with placeholders.", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
